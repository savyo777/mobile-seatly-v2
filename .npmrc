# Use legacy peer-dep resolution so npm ci on EAS Build accepts the
# existing tree. Without this, EAS fails install with:
#   react-dom@19.2.6 expects react@^19.2.6, but root pins react@19.2.0
# Local `npm install` was using --legacy-peer-deps; this file makes EAS
# do the same automatically and keeps local + CI behavior in sync.
legacy-peer-deps=true
